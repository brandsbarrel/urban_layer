NODE_ENV=development
PORT=4000
APP_NAME=Urban Layers API
API_BASE_PATH=/api

# Core infrastructure
MONGO_URI=mongodb://127.0.0.1:27017/urban-layers
REDIS_URL=redis://127.0.0.1:6379

# JWT secrets
ADMIN_JWT_ACCESS_SECRET=replace-with-a-strong-admin-access-secret-at-least-32-characters
CUSTOMER_JWT_ACCESS_SECRET=replace-with-a-strong-customer-access-secret-at-least-32-characters

# Frontend origin
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Shiprocket
SHIPROCKET_EMAIL=shiprocket-account@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_WEBHOOK_SECRET=your-shiprocket-webhook-secret

# Resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=no-reply@example.com

# First admin seed values
FIRST_ADMIN_NAME=Urban Layers Owner
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# Logging
LOG_LEVEL=info
